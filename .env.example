# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Database Connection String
# For local MongoDB: mongodb://127.0.0.1:27017/local_retail_pos
# For MongoDB Atlas Free Cloud: mongodb+srv://<username>:<password>@cluster0.mongodb.net/local_retail_pos?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/local_retail_pos

# JWT Authentication Secret (Use a strong random 32+ character string in production)
JWT_SECRET=super_secure_retailpos_saas_production_secret_key_change_me_2026

# Optional: Separate Frontend URL for CORS if deployed on separate domains (e.g. Vercel)
# FRONTEND_URL=https://my-retail-pos.vercel.app

# Optional: Mobile SMS Gateway Configuration for OTP (2-Step Verification & Forgot Password)
# If left empty, the server automatically uses local simulation and logs OTP to the server console.
# Fast2SMS (India):
# FAST2SMS_API_KEY=your_fast2sms_api_key_here
# 2Factor.in (India):
# TWO_FACTOR_API_KEY=your_2factor_api_key_here
# Twilio (Global):
# TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
# TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# TWILIO_PHONE_NUMBER=+1234567890

